{
  "expo": {
    "name": "orbit",
    "slug": "orbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "orbit",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.orbit.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.orbit.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Orbit to use the camera to record a space sighting.",
          "microphonePermission": false,
          "photosPermission": "Allow Orbit to choose a photo for your observation journal."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Orbit to attach your observing location to a sighting and save your observing locations."
        }
      ],
      "expo-status-bar",
      "expo-web-browser",
      "expo-dev-client",
      "expo-notifications",
      "react-native-nitro-google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "57c207ba-3a94-48d6-8e58-67b22e9d1d2b"
      }
    },
    "owner": "longbach"
  }
}
